# GuildPilot Environment Configuration

# Discord Bot Credentials (from Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# OAuth2 Redirect URI (Must match what is registered in Discord Developer Portal)
# Homeserver/Tailscale deployment
DISCORD_REDIRECT_URI=http://100.97.89.86:3101/api/auth/callback

# Security & Ownership
# Your personal Discord User ID. ONLY this user ID will be granted access to the dashboard.
ALLOWED_USER_ID=your_discord_user_id_here

# JWT Secret for local session security
JWT_SECRET=guildpilot_super_secret_local_key_change_me

# Runtime networking
PORT=3001
FRONTEND_URL=http://100.97.89.86:3100
CORS_ORIGINS=http://100.97.89.86:3100,http://192.168.178.176:3100
NEXT_PUBLIC_API_URL=http://100.97.89.86:3101

# Prisma SQLite Database URL
DATABASE_URL="file:/data/guildpilot.db"
