generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Template {
  id          String   @id @default(uuid())
  name        String
  description String?
  guildId     String?
  structure   String   // JSON payload containing channels, categories, roles, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  guildId   String
  action    String
  details   String
  timestamp DateTime @default(now())
}

model ServerBackup {
  id            String   @id @default(uuid())
  guildId       String
  guildName     String
  guildIcon     String?
  backupName    String
  backupType    String   @default("MANUAL") // MANUAL, AUTO_LEAVE, AUTO_SCHEDULED, IMPORTED
  reason        String?
  memberCount   Int      @default(0)
  channelsCount Int      @default(0)
  rolesCount    Int      @default(0)
  emojisCount   Int      @default(0)
  isBotInGuild  Boolean  @default(true)
  data          String   // JSON Snapshot
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TicketPanel {
  id                 String   @id @default(uuid())
  guildId            String
  name               String
  description        String?
  embedTitle         String?
  embedDescription   String?
  embedColor         String   @default("#5865F2")
  thumbnail          String?
  image              String?
  footer             String?
  welcomeTitle       String?  @default("👋 Welcome to your ticket!")
  welcomeDescription String?  @default("Support staff will be with you shortly. Use the controls below to manage this ticket.")
  welcomeColor       String   @default("#5865F2")
  welcomeThumbnail   String?
  welcomeImage       String?
  welcomeFooter      String?  @default("TheGodGen Ticket Engine")
  reasons            String   @default("[]") // JSON array of ticket reasons
  questions          String   @default("[]") // JSON array of global panel intake questions
  channelId          String?
  categoryId         String?
  buttonText         String   @default("Create Ticket")
  buttonEmoji        String?  @default("📩")
  buttonColor        String   @default("Primary")
  allowedRoles       String   @default("[]")
  supportRoles       String   @default("[]")
  maxOpenTickets     Int      @default(1)
  autoCloseHours     Int      @default(0)
  transcriptEnabled  Boolean  @default(true)
  messageId          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tickets            Ticket[]
}

model TicketCategory {
  id          String   @id @default(uuid())
  guildId     String
  name        String
  description String?
  emoji       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Ticket {
  id                 String       @id @default(uuid())
  ticketNumber       Int
  guildId            String
  panelId            String?
  panel              TicketPanel? @relation(fields: [panelId], references: [id], onDelete: SetNull)
  channelId          String       @unique
  userId             String
  userTag            String
  userAvatar         String?
  status             String       @default("OPEN") // OPEN, CLOSED, CLAIMED
  claimedByUserId    String?
  claimedByTag       String?
  claimedByAvatar    String?
  categoryId         String?
  closedByUserId     String?
  closedByTag        String?
  closeReason        String?
  staffMessageCounts String?      @default("{}") // JSON object of staffUserId -> message count
  openTimestamp      DateTime     @default(now())
  closedTimestamp    DateTime?
  closedAt           DateTime?
  transcriptUrl      String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  logs               TicketLog[]
}

model TicketLog {
  id           String   @id @default(uuid())
  guildId      String
  ticketId     String?
  ticket       Ticket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketNumber Int
  action       String   // OPENED, CLOSED, DELETED, CLAIMED, REOPENED, USER_ADDED, USER_REMOVED
  executorId   String
  executorTag  String
  details      String?
  timestamp    DateTime @default(now())
}

model TicketSetting {
  id                  String   @id @default(uuid())
  guildId             String   @unique
  namingFormat        String   @default("ticket-{username}") // ticket-{username}, {username}-ticket, ticket-{number}
  defaultSupportRoles String   @default("[]") // JSON array of role IDs
  defaultCategoryId   String?
  logChannelId        String?
  closeConfirmation   Boolean  @default(true)
  deleteDelaySeconds  Int      @default(5)
  transcriptStorage   String   @default("local") // local, none
  maxTicketsPerUser   Int      @default(3)
  autoArchive         Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

model AppPanel {
  id                 String        @id @default(uuid())
  guildId            String
  name               String
  description        String?
  displayType        String        @default("dropdown") // dropdown, button
  embedTitle         String?       @default("📝 Application Center")
  embedDescription   String?       @default("Select an application position from the dropdown menu below to submit your application.")
  embedColor         String        @default("#5865F2")
  embedAuthorName    String?
  embedAuthorIcon    String?
  embedAuthorUrl     String?
  thumbnail          String?
  image              String?
  footer             String?       @default("GuildPilot Applications System")
  footerIcon         String?
  showTimestamp      Boolean       @default(true)
  embedFields        String        @default("[]") // JSON string of [{ name, value, inline }]

  dmTitle            String?       @default("📝 Application Intake")
  dmDescription      String?       @default("Click the button below to complete your application questions.")
  dmColor            String        @default("#5865F2")
  dmAuthorName       String?
  dmAuthorIcon       String?
  dmThumbnail        String?
  dmImage            String?
  dmFooter           String?       @default("GuildPilot Application System")
  dmFooterIcon       String?

  welcomeTitle       String?       @default("👋 Application Submitted!")
  welcomeDescription String?       @default("Your application has been received. Reviewers will inspect your answers shortly.")
  welcomeColor       String        @default("#5865F2")
  welcomeAuthorName  String?
  welcomeAuthorIcon  String?
  welcomeThumbnail   String?
  welcomeImage       String?
  welcomeFooter      String?       @default("GuildPilot Applications System")
  welcomeFooterIcon  String?

  acceptMessage          String?       @default("🎉 Congratulations {user}! Your application for {form_name} (App #{app_number}) was ACCEPTED!")
  acceptEmbedTitle       String?       @default("🎉 Application Accepted!")
  acceptEmbedDescription String?       @default("Congratulations! Your application has been accepted by our staff team.")
  acceptEmbedColor       String        @default("#23A55A")

  denyMessage            String?       @default("❌ Hello {user}, your application for {form_name} (App #{app_number}) was DENIED.")
  denyEmbedTitle         String?       @default("❌ Application Decision")
  denyEmbedDescription   String?       @default("Thank you for applying. Unfortunately, your application was not accepted at this time.")
  denyEmbedColor         String        @default("#F23F43")

  waitlistMessage        String?       @default("⏳ Hello {user}, your application for {form_name} (App #{app_number}) was placed on WAITLIST.")
  waitlistEmbedTitle     String?       @default("⏳ Application Waitlisted")
  waitlistEmbedDescription String?     @default("Your application has been placed on our waitlist. We will contact you when a position opens up.")
  waitlistEmbedColor     String        @default("#F0B232")

  channelId          String?
  messageId          String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  forms              AppForm[]
}

model AppForm {
  id                 String        @id @default(uuid())
  guildId            String
  panelId            String?
  panel              AppPanel?     @relation(fields: [panelId], references: [id], onDelete: SetNull)
  name               String
  description        String?
  emoji              String?       @default("📝")
  category           String?       @default("General")
  displayType        String        @default("dropdown") // dropdown, button
  embedTitle         String?       @default("📝 Server Applications")
  embedDescription   String?       @default("Select an application position from the dropdown menu below to submit your application.")
  embedColor         String        @default("#5865F2")
  embedAuthorName    String?
  embedAuthorIcon    String?
  embedAuthorUrl     String?
  thumbnail          String?
  image              String?
  footer             String?       @default("GuildPilot Applications System")
  footerIcon         String?
  showTimestamp      Boolean       @default(true)
  embedFields        String        @default("[]")

  dmTitle            String?       @default("📝 Application Intake")
  dmDescription      String?       @default("Click the button below to complete your application questions.")
  dmColor            String        @default("#5865F2")
  dmAuthorName       String?
  dmAuthorIcon       String?
  dmThumbnail        String?
  dmImage            String?
  dmFooter           String?       @default("GuildPilot Application System")
  dmFooterIcon       String?

  welcomeTitle       String?       @default("👋 Application Submitted!")
  welcomeDescription String?       @default("Your application has been received. Reviewers will inspect your answers shortly.")
  welcomeColor       String        @default("#5865F2")
  welcomeAuthorName  String?
  welcomeAuthorIcon  String?
  welcomeThumbnail   String?
  welcomeImage       String?
  welcomeFooter      String?       @default("GuildPilot Applications System")
  welcomeFooterIcon  String?

  acceptMessage          String?       @default("🎉 Congratulations {user}! Your application for {form_name} (App #{app_number}) was ACCEPTED!")
  acceptEmbedTitle       String?       @default("🎉 Application Accepted!")
  acceptEmbedDescription String?       @default("Congratulations! Your application has been accepted by our staff team.")
  acceptEmbedColor       String        @default("#23A55A")

  denyMessage            String?       @default("❌ Hello {user}, your application for {form_name} (App #{app_number}) was DENIED.")
  denyEmbedTitle         String?       @default("❌ Application Decision")
  denyEmbedDescription   String?       @default("Thank you for applying. Unfortunately, your application was not accepted at this time.")
  denyEmbedColor         String        @default("#F23F43")

  waitlistMessage        String?       @default("⏳ Hello {user}, your application for {form_name} (App #{app_number}) was placed on WAITLIST.")
  waitlistEmbedTitle     String?       @default("⏳ Application Waitlisted")
  waitlistEmbedDescription String?     @default("Your application has been placed on our waitlist. We will contact you when a position opens up.")
  waitlistEmbedColor     String        @default("#F0B232")

  buttonText         String        @default("Apply Now")
  buttonEmoji        String?       @default("📝")
  buttonColor        String        @default("Primary") // Primary, Secondary, Success, Danger
  targetChannelId    String?
  categoryId         String?
  reviewerRoles      String        @default("[]") // JSON array of role IDs
  applicantRoles     String        @default("[]") // JSON array of allowed role IDs
  acceptedRoles      String        @default("[]") // JSON array of role IDs to grant on Accept
  deniedRoles        String        @default("[]") // JSON array of role IDs to grant/remove on Deny
  cooldownHours      Int           @default(24)
  maxActiveApps      Int           @default(1)
  isOpen             Boolean       @default(true)
  messageId          String?
  channelId          String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  questions          AppQuestion[]
  applications       Application[]
}

model AppQuestion {
  id              String   @id @default(uuid())
  formId          String
  form            AppForm  @relation(fields: [formId], references: [id], onDelete: Cascade)
  label           String
  type            String   @default("SHORT_TEXT") // SHORT_TEXT, PARAGRAPH, MULTIPLE_CHOICE, DROPDOWN, YES_NO, NUMBER, DATE
  placeholder     String?
  required        Boolean  @default(true)
  options         String   @default("[]") // JSON array of options
  minLength       Int?
  maxLength       Int?
  validationRegex String?
  validationError String?
  helpText        String?
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Application {
  id              String             @id @default(uuid())
  appNumber       Int
  guildId         String
  formId          String?
  form            AppForm?           @relation(fields: [formId], references: [id], onDelete: SetNull)
  channelId       String?            @unique
  userId          String
  userTag         String
  userAvatar      String?
  accountAge      String?
  joinDate        String?
  currentRoles    String             @default("[]") // JSON array of role names/IDs
  attachments     String             @default("[]") // JSON array of attachment URLs
  status          String             @default("PENDING") // PENDING, UNDER_REVIEW, CLAIMED, ACCEPTED, DENIED, WAITLISTED, CLOSED
  claimedByUserId String?
  claimedByTag    String?
  claimedByAvatar String?
  decisionReason  String?
  submittedAt     DateTime           @default(now())
  reviewedAt      DateTime?
  closedAt        DateTime?
  transcriptUrl   String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  answers         AppAnswer[]
  notes           AppNote[]
  history         AppStatusHistory[]
}

model AppAnswer {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questionId    String?
  questionLabel String
  questionType  String
  value         String
}

model AppNote {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorId      String
  authorTag     String
  authorAvatar  String?
  content       String
  createdAt     DateTime    @default(now())
}

model AppStatusHistory {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        String      @default("PENDING")
  fromStatus    String?
  toStatus      String?
  actorId       String      @default("system")
  actorTag      String      @default("System")
  changedById   String?
  changedByTag  String?
  details       String?
  reason        String?
  timestamp     DateTime    @default(now())
  createdAt     DateTime    @default(now())
}

model AppIntakeSession {
  id          String   @id @default(uuid())
  guildId     String
  formId      String
  userId      String   @unique
  currentStep Int      @default(0)
  answers     String   @default("[]") // JSON string of [{ questionId, questionLabel, questionType, value }]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AppSettings {
  id                   String   @id @default(uuid())
  guildId              String   @unique
  defaultReviewerRoles String   @default("[]") // JSON array of role IDs
  defaultCategoryId    String?
  archiveCategoryId    String?
  logChannelId         String?
  transcriptStorage    String   @default("local") // local, none
  defaultCooldownHours Int      @default(24)
  maxAppsPerUser       Int      @default(1)
  autoCloseHours       Int      @default(0) // 0 = disabled
  autoArchive          Boolean  @default(false)
  timezone             String   @default("UTC")
  updatedAt            DateTime @updatedAt
}

model AppLog {
  id            String   @id @default(uuid())
  guildId       String
  applicationId String?
  action        String   // SUBMITTED, CLAIMED, UNCLAIMED, ACCEPTED, DENIED, WAITLISTED, REOPENED, NOTE_ADDED, CLOSED
  executorId    String
  executorTag   String
  details       String?
  timestamp     DateTime @default(now())
}

model SelfRolePanel {
  id                 String           @id @default(uuid())
  guildId            String
  name               String
  description        String?
  displayType        String           @default("button") // button, dropdown
  layoutMode         String           @default("components_v2") // components_v2, embed
  multiSelect        Boolean          @default(true)
  placeholderText    String?          @default("Select roles...")

  // Embed Customization
  embedTitle         String?          @default("🔔 Choose your Ping Roles")
  embedDescription   String?          @default("Click a button below to receive or remove a role.")
  embedColor         String           @default("#5865F2")
  embedAuthorName    String?
  embedAuthorIcon    String?
  embedAuthorUrl     String?
  thumbnail          String?
  image              String?
  footer             String?          @default("GuildPilot Self Roles")
  footerIcon         String?
  showTimestamp      Boolean          @default(false)
  embedFields        String           @default("[]") // JSON string of [{ name, value, inline }]

  // Notification Messages
  addRoleMessage     String?          @default("✅ Added role {role}!")
  removeRoleMessage  String?          @default("❌ Removed role {role}!")
  ephemeralResponse  Boolean          @default(true)

  // Discord Message Details
  channelId          String?
  messageId          String?

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  options            SelfRoleOption[]
}

model SelfRoleOption {
  id              String        @id @default(uuid())
  panelId         String
  panel           SelfRolePanel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  roleId          String
  roleName        String?
  roleColor       String?
  label           String?       // Override label or null to use roleName
  emoji           String?       // Unicode or custom emoji string e.g. 📩 or <:custom:1234>
  buttonColor     String        @default("Secondary") // Primary (Blue), Secondary (Gray), Success (Green), Danger (Red)
  description     String?       // Description for dropdown menu item
  showMemberCount Boolean       @default(true) // Appends count like "News (117)"
  requiredRoles   String        @default("[]") // JSON string of role IDs required to pick this
  exclusiveGroup  String?       // Subgroup name for mutually exclusive roles within this panel
  order           Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model CustomMessage {
  id              String    @id @default(uuid())
  guildId         String
  name            String
  description     String?
  mode            String    @default("components_v2") // components_v2, embed, plain
  channelId       String?
  messageId       String?
  content         String?   // Plain text / fallback content (only used when not components_v2)
  flags           Int?      @default(32768) // 32768 = MessageFlags.IsComponentsV2
  accentColor     String?   @default("#5865F2")
  spoiler         Boolean   @default(false)
  containerConfig String?   @default("[]") // JSON array of Components V2 items (TextDisplay, Section, MediaGallery, Separator, ActionRow)
  embedConfig     String?   @default("{}") // JSON object of legacy Embed config
  componentsConfig String?  @default("[]") // JSON array of ActionRows (for embed mode)
  lastSentAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model WelcomeSetting {
  id              String   @id @default(uuid())
  guildId         String   @unique
  enabled         Boolean  @default(false)
  channelId       String?
  messageText     String   @default("Welcome {user} to **{server}**!")
  cardTitle       String   @default("Welcome @{username}")
  cardSubtitle    String   @default("Member #{memberCount}")
  avatarRingColor String   @default("#00d2d3")
  cardBgColor     String   @default("#18191c")
  cardBorderColor String   @default("#2b2d31")
  cardBgImage     String?
  sendCard        Boolean  @default(true)
  sendDm          Boolean  @default(false)
  dmText          String?  @default("Welcome to {server}, {user}!")
  autoRoles       String   @default("[]") // JSON string of role IDs
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LeaveSetting {
  id              String   @id @default(uuid())
  guildId         String   @unique
  enabled         Boolean  @default(false)
  channelId       String?
  messageText     String   @default("**{username}** has left the server. We will miss you!")
  cardTitle       String   @default("Goodbye @{username}")
  cardSubtitle    String   @default("Left {server} • {memberCount} members remain")
  avatarRingColor String   @default("#f43f5e")
  cardBgColor     String   @default("#18191c")
  cardBorderColor String   @default("#2b2d31")
  cardBgImage     String?
  sendCard        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AutoReact {
  id         String   @id @default(uuid())
  guildId    String
  name       String
  enabled    Boolean  @default(true)
  channelIds String   @default("[]") // JSON array of channel IDs
  emojis     String   @default("[]") // JSON array of emoji strings (e.g. ["👍", "🔥", "<:custom:123>"])
  ignoreBots Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}


